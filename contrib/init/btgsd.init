#!/usr/bin/env bash
#
#  btgsd The BTGS Core server.
#
#
# chkconfig: 345 80 20
# description: btgsd
# processname: btgsd
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/btgsd, see below
if [ -f /etc/sysconfig/btgsd ]; then
        . /etc/sysconfig/btgsd
fi

RETVAL=0

prog=btgsd
# you can override the lockfile via BITCOIND_LOCKFILE in /etc/sysconfig/btgsd
lockfile=${BITCOIND_LOCKFILE-/var/lock/subsys/btgsd}

# btgsd defaults to /usr/bin/btgsd, override with BITCOIND_BIN
btgsd=${BITCOIND_BIN-/usr/bin/btgsd}

# btgsd opts default to -disablewallet, override with BITCOIND_OPTS
btgsd_opts=${BITCOIND_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $btgsd $btgsd_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog -t600
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
